{
  "name": "@framediff/example-cloth-showcase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A deterministic kinetic-poster showcase for FrameDiff's reusable DOM-to-cloth effect.",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:authoring": "node vendor/framediff/scripts/check-example-authoring.mjs .",
    "check:bundle": "node vendor/framediff/scripts/check-bundle-budgets.mjs .",
    "typecheck": "npm run check",
    "test": "vitest run src/compositions/KineticCloth.test.ts"
  },
  "dependencies": {
    "@framediff/common-api": "file:vendor/framediff/packages/common-api",
    "@framediff/studio-model": "file:vendor/framediff/packages/studio-model",
    "@framediff/studio-ui": "file:vendor/framediff/packages/studio-ui",
    "framediff": "file:vendor/framediff/packages/framediff",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
